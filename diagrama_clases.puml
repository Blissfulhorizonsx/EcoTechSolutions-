@startuml
skinparam classAttributeIconSize 0

class Departamento {
    -idDepart: int
    -nombDepart: String
    -gerentDepart: String
    +getIdDepart(): int
    +getNombDepart(): String
    +getGerentDepart(): String
    +setIdDepart(v: int): void
    +setNombDepart(v: String): void
    +setGerentDepart(v: String): void
}

class Usuario {
    -idUsuario: int
    -nombreUsuario: String
    -contrasena: String
    -rol: String
    +getIdUsuario(): int
    +getNombreUsuario(): String
    +getContrasena(): String
    +getContrasenaHash(): String
    +getRol(): String
    +setIdUsuario(idUsuario: int): void
    +setNombreUsuario(nombreUsuario: String): void
    +setContrasena(contrasena: String): void
    +setRol(rol: String): void
}

class Administrador {
    +esAdmin(): Boolean
}

class Empleado {
    -idEmple: int
    -nombEmplea: String
    -direccEmple: String
    -numEmple: String
    -mailEmple: String
    -fchContrato: Date
    -salarioCifrado: String
    -idDepart: int
    -descifrarCampo(valor: String): String
    +obtenerSalarioDescifrado(): Float
    +obtenerCorreoDescifrado(): String
    +obtenerTelefonoDescifrado(): String
    +getIdEmple(): int
    +getNombEmplea(): String
    +getDireccEmple(): String
    +getNumEmple(): String
    +getMailEmple(): String
    +getFchContrato(): Date
    +getSalarioCifrado(): String
    +getIdDepart(): int
    +setIdEmple(v: int): void
    +setNombEmplea(v: String): void
    +setDireccEmple(v: String): void
    +setNumEmple(v: String): void
    +setMailEmple(v: String): void
    +setFchContrato(v: Date): void
    +setSalarioCifrado(v: String): void
    +setIdDepart(v: int): void
}

class Proyecto {
    -idProyecto: int
    -nombProyecto: String
    -descripProyecto: String
    -fchInicio: Date
    +getIdProyecto(): int
    +getNombProyecto(): String
    +getDescripProyecto(): String
    +getFchInicio(): Date
    +setIdProyecto(v: int): void
    +setNombProyecto(v: String): void
    +setDescripProyecto(v: String): void
    +setFchInicio(v: Date): void
}

class RegistroTiempo {
    -idRegistro: int
    -fchTrabajo: Date
    -horaInicio: String
    -horaTermino: String
    -descripTareas: String
    -idEmple: int
    -idProyecto: int
    {static} -aTimedelta(valor: any): timedelta
    +calcularHoras(): String
    +getIdRegistro(): int
    +getFchTrabajo(): Date
    +getHoraInicio(): String
    +getHoraTermino(): String
    +getDescripTareas(): String
    +getIdEmple(): int
    +getIdProyecto(): int
    +setIdRegistro(v: int): void
    +setFchTrabajo(v: Date): void
    +setHoraInicio(v: String): void
    +setHoraTermino(v: String): void
    +setDescripTareas(v: String): void
    +setIdEmple(v: int): void
    +setIdProyecto(v: int): void
}

class Asignacion {
    -idAsign: int
    -fechaAsignacion: Date
    -idEmple: int
    -idProyecto: int
    +getIdAsign(): int
    +getFechaAsignacion(): Date
    +getIdEmple(): int
    +getIdProyecto(): int
    +setIdAsign(v: int): void
    +setFechaAsignacion(v: Date): void
    +setIdEmple(v: int): void
    +setIdProyecto(v: int): void
}

class Informe {
    -idInforme: int
    -fchGeneracion: Date
    -formato: String
    -contenido: String
    -idUsuario: int
    +getIdInforme(): int
    +getFchGeneracion(): Date
    +getFormato(): String
    +getContenido(): String
    +getIdUsuario(): int
    +setIdInforme(v: int): void
    +setFchGeneracion(v: Date): void
    +setFormato(v: String): void
    +setContenido(v: String): void
    +setIdUsuario(v: int): void
}

class Indicador {
    -idIndicador: int
    -idUsuario: int
    -autor: String
    -codigo: String
    -fecha: Date
    -valor: Float
    +getIdIndicador(): int
    +getIdUsuario(): int
    +getAutor(): String
    +getCodigo(): String
    +getFecha(): Date
    +getValor(): Float
    +setIdIndicador(v: int): void
    +setIdUsuario(v: int): void
    +setAutor(v: String): void
    +setCodigo(v: String): void
    +setFecha(v: Date): void
    +setValor(v: Float): void
}

class RecuperacionClave {
    -idRecuperacion: int
    -idUsuario: int
    -codigoHash: String
    -expira: DateTime
    -usado: Boolean
    -intentos: int
    -creado: DateTime
    +getIdRecuperacion(): int
    +getIdUsuario(): int
    +getCodigoHash(): String
    +getExpira(): DateTime
    +getUsado(): Boolean
    +getIntentos(): int
    +getCreado(): DateTime
    +setIdRecuperacion(v: int): void
    +setIdUsuario(v: int): void
    +setCodigoHash(v: String): void
    +setExpira(v: DateTime): void
    +setUsado(v: Boolean): void
    +setIntentos(v: int): void
    +setCreado(v: DateTime): void
}

class ValidadorSeguridad {
    {static} -clave: bytes
    {static} -cargarClave(): bytes
    +sanitizar_entrada(dato: String): String
    +cifrar_dato_sensible(dato: String): String
    +descifrar_dato_sensible(dato: String): String
}

Usuario <|-- Administrador
Usuario <|-- Empleado

Departamento "1" -- "0..*" Empleado : pertenece a >
Usuario "1" -- "0..*" Informe : genera >
Usuario "1" -- "0..*" Indicador : consulta >
Usuario "1" -- "0..*" RecuperacionClave : solicita >
Empleado "1" -- "0..*" RegistroTiempo : registra >
Proyecto "1" -- "0..*" RegistroTiempo : recibe >
Empleado "1" -- "0..*" Asignacion : tiene >
Proyecto "1" -- "0..*" Asignacion : recibe >

Empleado ..> ValidadorSeguridad : usa para cifrar/descifrar
@enduml